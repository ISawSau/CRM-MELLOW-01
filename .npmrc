engine-strict=true
# Las dependencias no ejecutan scripts de instalación (ver docs/DECISIONS.md, D-021):
# better-sqlite3 intentaría compilar SQLite con Visual Studio aunque ya trae el
# binario precompilado, y es el vector típico de ataques a la cadena de suministro.
# `npm run …` y `npm test` siguen funcionando con normalidad.
ignore-scripts=true
