{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node", "electron-vite/node", "vite/client"]
  },
  "include": [
    "src/main/**/*",
    "src/mobile/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "tests/unit/**/*",
    "src/renderer/src/theme/themes.ts",
    "electron.vite.config.ts",
    "vitest.config.ts",

    "drizzle.config.ts"
  ]
}
